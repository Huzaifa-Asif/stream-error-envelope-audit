{
  "name": "stream-error-envelope-audit",
  "version": "1.0.0",
  "description": "Normalize and audit provider error envelopes without losing retry evidence.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs", "require": "./src/index.cjs" } },
  "files": ["src/", "examples/", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md", "SECURITY.md", "CODE_OF_CONDUCT.md"],
  "scripts": {
    "build": "node scripts/verify-package.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --experimental-test-coverage",
    "example": "node examples/audit-errors.mjs",
    "check": "npm run lint && npm run build && npm test && npm run example && npm pack --dry-run --json --cache ./.npm-cache"
  },
  "engines": { "node": ">=20" },
  "keywords": ["ai", "stream", "error", "retry", "audit", "diagnostics"],
  "license": "MIT",
  "author": "Huzaifa Asif",
  "repository": { "type": "git", "url": "git+https://github.com/Huzaifa-Asif/stream-error-envelope-audit.git" },
  "bugs": { "url": "https://github.com/Huzaifa-Asif/stream-error-envelope-audit/issues" },
  "homepage": "https://github.com/Huzaifa-Asif/stream-error-envelope-audit#readme",
  "publishConfig": { "access": "public" }
}
